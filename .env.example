ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Model do przepisów: gemini-..., groq/<model> (np. groq/openai/gpt-oss-120b) albo ollama/<model> (np. ollama/qwen2.5:3b)
RECIPE_MODEL=gemini-3.1-flash-lite

# Baza przepisów dla POST /recipes (domyślnie data/recipes.sqlite)
RECIPES_DB=

# Adres lokalnej Ollamy (domyślnie http://localhost:11434/v1)
OLLAMA_BASE_URL=

# Limity czasu LLM w sekundach (M5.5). Puste = domyślne: 15 s na wywołanie i 45 s na całe /recipes,
# dla ollama/... 120 s i 300 s
LLM_TIMEOUT_S=
RECIPES_BUDGET_S=
